{
  "name": "mmo-skill-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run ./build.ts",
    "dev": "bun run ./build.ts && bun run ./server.ts",
    "simulate:onboarding": "bun run ./scripts/onboarding-player-sim.ts",
    "audit:early-zero": "bun run ./scripts/early-loop-zero-risk-audit.ts --strict",
    "screenshot:world": "bun run ./scripts/capture-world-areas.ts",
    "bench:regions": "bun run ./scripts/region-teleport-bench.ts",
    "bench:regions:quick": "bun run ./scripts/region-teleport-bench.ts --frames=8 --priming=12 --repeats=2",
    "bench:dungeon": "bun run ./scripts/dungeon-20-player-bench.ts",
    "bench:dungeon:quick": "bun run ./scripts/dungeon-20-player-bench.ts --ticks=60 --warmup=20",
    "audit:loops": "bun run ./scripts/gameplay-loop-audit.ts",
    "test": "bun test src/tests"
  }
}
