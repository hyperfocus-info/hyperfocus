    "smoke:wasm-hosting": "bun ./scripts/wasm-hosting-smoke.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p ./tsconfig.test.json",
    "typecheck:tooling": "tsc --noEmit -p ./tsconfig.tooling.json",
    "typecheck:examples": "tsc --noEmit -p ./examples/tsconfig.json",
    "typecheck:examples:integration": "tsc --noEmit -p ./examples/tsconfig.integration.json",
    "typecheck:editor": "tsc --noEmit -p ../apps/engine-editor/tsconfig.json",
    "test": "bun test ./src",
    "test:all": "bun test",
    "test:net": "bun test ./src/net ./src/sync ./src/runtime/rollback.test.ts",
    "test:server": "bun test ./src/server ./src/protocol",
    "bench:rollback": "bun test ./src/runtime/rollback.bench.test.ts",
    "bench:protocol": "bun test ./src/protocol/protocol.bench.test.ts",
    "bench:server": "bun test ./src/server/mmo-load.bench.test.ts ./src/server/mmo-scale.bench.test.ts",
    "bench:mmo": "bun test ./src/server/mmo-load.bench.test.ts",
