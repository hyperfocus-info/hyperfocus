{
  "name": "@hyperfocus/ai-core",
  "version": "0.0.1",
  "description": "Typed, framework-neutral contracts and clients for Hyperfocus AI runtimes.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./capacity-governor": "./src/capacity-governor.ts",
    "./agent-catalog": "./src/harness/agent-catalog.ts",
    "./app-version": "./src/harness/app-version.ts",
    "./background-job-templates": "./src/harness/background-job-templates.ts",
    "./capabilities": "./src/harness/capabilities.ts",
    "./chat-attachments": "./src/harness/chat-attachments.ts",
    "./intent-contract": "./src/harness/intent-contract.ts",
    "./mode-intent": "./src/harness/mode-intent.ts",
    "./protocol": "./src/harness/protocol/index.ts",
    "./modes": "./src/harness/modes.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --format esm --external zod",
    "typecheck": "tsc --noEmit -p ../../tsconfig.packages.json",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
