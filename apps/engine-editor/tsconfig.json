{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@hyperfocus/engine": ["../../packages/engine/src/index.ts"],
      "@hyperfocus/engine/*": ["../../packages/engine/src/*"],
      "@hyperfocus/ai-core": ["../../packages/ai-core/src/index.ts"],
      "@hyperfocus/ui": ["../../packages/ui/src/index.ts"],
      "@hyperfocus/workspace": ["../../packages/workspace/src/index.ts"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../packages/ai-core/src/**/*.ts",
    "../../packages/desktop-runtime/src/**/*.ts",
    "../../packages/engine/src/**/*.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../packages/workspace/src/**/*.ts"
  ],
  "exclude": ["dist", "**/*.test.ts", "**/*.test.tsx"]
}
