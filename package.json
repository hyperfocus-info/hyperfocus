{
  "name": "hyperfocus",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "overrides": {
    "@types/node": "25.9.5",
    "@babel/core": "7.29.7",
    "effect": "3.22.1",
    "image-size": "npm:image-size-next@2.1.0",
    "js-yaml": "3.15.1",
    "lodash": "4.18.1",
    "picomatch": "4.0.5",
    "seroval": "1.5.6",
    "seroval-plugins": "1.5.6",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "ws": "8.21.1",
    "yaml": "2.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/engine/examples/touch-of-death"
  ],
  "scripts": {
    "swarm": "bun apps/harness/scripts/swarm/cli.ts",
    "swarm:deploy": "bun apps/harness/scripts/swarm/deploy.ts",
    "connections": "bun apps/harness/scripts/connections.ts",
    "swarm:auth": "bun apps/harness/scripts/swarm/auth.ts",
    "swarm:test": "bun test apps/harness/cli/src/swarm apps/harness/cli/src/connections apps/harness/scripts/swarm packages/ai-core/src/swarm packages/performance/swarm packages/ai-runtime/src/swarm packages/ai-runtime/src/agent-events.test.ts packages/ai-runtime/src/connections.test.ts packages/ai-runtime/src/process/codex-subscription.test.ts packages/ai-runtime/src/process/codex-connection.live.test.ts apps/swarm-worker/src --timeout 30000",
    "swarm:cloud-test": "bun apps/swarm-worker/scripts/verify-cloud.ts",
    "swarm:verify-ui": "bun apps/harness/scripts/swarm/verify-ui.ts",
    "swarm:verify-workflow": "bun apps/harness/scripts/swarm/verify-workflow.ts",
    "swarm:verify-live": "bun apps/harness/scripts/swarm/verify-live.ts",
    "dev": "bun .agents/skills/dev-server/scripts/dev.ts",
    "dev:harness": "bun .agents/skills/dev-server/scripts/dev.ts start harness",
    "dev:editor": "bun .agents/skills/dev-server/scripts/dev.ts start editor",
    "dev:pad-pilot": "bun .agents/skills/dev-server/scripts/dev.ts start pad-pilot",
    "dev:pad-pilot-marketplace": "bun .agents/skills/dev-server/scripts/dev.ts start pad-pilot",
    "dev:status": "bun .agents/skills/dev-server/scripts/dev.ts status",
    "dev:logs": "bun .agents/skills/dev-server/scripts/dev.ts logs",
    "dev:errors": "bun .agents/skills/dev-server/scripts/dev.ts errors",
    "dev:stop": "bun .agents/skills/dev-server/scripts/dev.ts stop",
    "bench:serialization": "bun scripts/serialization/run.ts",
    "test:serialization": "bun test scripts/serialization packages/serialization/src packages/engine/examples/touch-of-death/src/replay",
    "build": "bun run build:packages && bun run build:harness && bun run build:editor && bun run build:engine && bun run build:pad-pilot",
    "build:packages": "bun run --cwd packages/utilities build && bun run --cwd packages/serialization build && bun run --cwd packages/workspace build && bun run --cwd packages/desktop-runtime build && bun run --cwd packages/ai-core build && bun run --cwd packages/ai-runtime build && bun run --cwd packages/pad-pilot build && bun run --cwd packages/ui build",
    "build:harness": "bun apps/harness/scripts/build-ui.ts --minify",
    "build:editor": "bun apps/engine-editor/build.ts",
    "build:engine": "bun run --cwd packages/engine build",
    "build:pad-pilot": "bun run --cwd apps/pad-pilot build:ui",
    "build:pad-pilot-native": "bun run --cwd apps/pad-pilot build:release",
    "typecheck": "bun run typecheck:packages && bun run typecheck:harness && bun run typecheck:editor && bun run typecheck:engine && bun run typecheck:pad-pilot",
    "typecheck:packages": "bunx tsc --noEmit -p tsconfig.packages.json",
    "typecheck:harness": "bunx tsc --noEmit -p apps/harness/tsconfig.json",
    "typecheck:editor": "bunx tsc --noEmit -p apps/engine-editor/tsconfig.json",
    "typecheck:engine": "bun run --cwd packages/engine typecheck && bun run --cwd packages/engine typecheck:tests && bun run --cwd packages/engine typecheck:tooling && bun run --cwd packages/engine typecheck:examples",
    "typecheck:pad-pilot": "bun run --cwd apps/pad-pilot typecheck && bun run --cwd apps/pad-pilot-marketplace typecheck",
    "test": "bun run test:repository && bun run test:packages && bun run test:harness && bun run test:editor && bun run test:engine && bun run test:pad-pilot",
    "test:repository": "bun test scripts/check-repository-size.test.ts scripts/check-source-structure.test.ts scripts/check-code-style.test.ts scripts/numeric-literals scripts/code-standards scripts/ui-attention scripts/eslint-config.test.ts scripts/check-license-scope.test.ts scripts/app-ui-boundary.test.ts scripts/documentation-policy.test.ts scripts/release-readiness.test.ts scripts/dev-server.test.ts scripts/process-policy scripts/context-audit scripts/project-discovery scripts/testing scripts/ai-runtime scripts/shipping scripts/game-art scripts/albums ./.agents/skills/user-audit/scripts ./.agents/skills/dev-server/scripts",
    "test:packages": "bun scripts/testing/run-package-tests.ts",
    "test:harness": "bun apps/harness/scripts/run-tests.ts",
    "test:editor": "bun test apps/engine-editor",
    "test:engine": "bun run --cwd packages/engine test",
    "test:pad-pilot": "bun run --cwd apps/pad-pilot test:fast",
    "test:pad-pilot-native": "bun run --cwd apps/pad-pilot test:native",
    "verify:editor": "bun apps/engine-editor/verify-client.ts",
    "verify:editor:system": "bun apps/engine-editor/verify-system.ts",
    "lint": "bunx --bun eslint packages apps scripts .agents/skills --max-warnings 0",
    "lint:fix": "bunx --bun eslint --fix packages apps scripts .agents/skills --max-warnings 0",
    "check:repository-size": "bun scripts/check-repository-size.ts",
    "check:release-readiness": "bun scripts/release-readiness.ts",
    "ship-check": "bun scripts/shipping/check.ts",
    "inspect:project": "bun apps/harness/cli/src/project-discovery/inspect.ts",
    "inspect:impact": "bun scripts/project-discovery/impact.ts",
    "inspect:outcome": "bun scripts/context-audit/outcome/cli.ts",
    "check:source-structure": "bun scripts/check-source-structure.ts",
    "ratchet:source-structure": "bun scripts/check-source-structure.ts --ratchet",
    "check:code-style": "bun scripts/check-code-style.ts",
    "audit:code-standards": "bun scripts/code-standards/audit.ts",
    "check:process-policy": "bun scripts/process-policy/check.ts",
    "check:agent-guidance": "bun scripts/context-audit/check.ts",
    "art:create": "bun scripts/game-art/create.ts",
    "ratchet:code-style": "bun scripts/check-code-style.ts --ratchet",
    "check": "bun run check:agent-guidance && bun run check:process-policy && bun run check:repository-size && bun run check:release-readiness && bun run check:source-structure && bun run check:code-style && bun run lint && bun run typecheck && bun run test && bun run build",
    "protobuf:convert": "bun scripts/serialization/convert.ts",
    "package:harness:npm": "bun apps/harness/scripts/npm/package.ts"
  },
  "devDependencies": {
    "@hyperfocus/utilities": "workspace:*",
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@bufbuild/protobuf": "^2.13.0",
    "@clerk/backend": "^3.20.1",
    "@hyperfocus/desktop-runtime": "workspace:*",
    "@hyperfocus/ai-core": "workspace:*",
    "@hyperfocus/ai-runtime": "workspace:*",
    "@hyperfocus/engine": "workspace:*",
    "@hyperfocus/touch-of-death": "workspace:*",
    "@hyperfocus/ui": "workspace:*",
    "@hyperfocus/pad-pilot": "workspace:*",
    "@hyperfocus/performance": "workspace:*",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "1.4.0",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "babel-preset-solid": "^1.9.12",
    "chrome-remote-interface": "^0.34.0",
    "eslint": "^10.2.0",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "@hyperfocus/serialization": "workspace:*",
    "grpc-tools": "^1.13.1",
    "@hyperfocus/branding": "workspace:*",
    "@hyperfocus/website-host": "workspace:*",
    "@hyperfocus/artifact-review": "workspace:*",
    "@hyperfocus/review-store": "workspace:*"
  },
  "patchedDependencies": {
    "@openai/codex-sdk@0.149.1": "patches/@openai%2Fcodex-sdk@0.149.1.patch",
    "@mariozechner/pi-coding-agent@0.73.1": "patches/@mariozechner%2Fpi-coding-agent@0.73.1.patch",
    "playwright-core@1.62.1": "patches/playwright-core@1.62.1.patch"
  }
}
