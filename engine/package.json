    "verify:examples": "bun run typecheck:examples && bun run typecheck:examples:integration && bun test ./examples/example-manifest.test.ts ./examples/public-alias.test.ts && bun run build:examples",
    "bench:example:three-arena:network": "bun run ./examples/three-arena/network-bench.ts",
    "bench:example:three-arena:stress500": "bun run ./examples/three-arena/bench.ts --stress-enemies 500 --stress-pickups 500 --stress-effects 1000 --stress-all-props --duration-ms 10000 --assert-enemies 500 --assert-pickups 500 --assert-particles 1000 --assert-animated-enemies-max 4 --assert-frame-p95-ms 16.7 --assert-update-p95-ms 8 --assert-render-p95-ms 10 --assert-triangles-max 45000 --assert-programs-max 48 --assert-mesh-delta-max 8 --assert-material-delta-max 8"
