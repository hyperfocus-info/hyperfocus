    "codemirror": "^6.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "solid-markdown": "^2.1.1",
    "babel-preset-solid": "^1.9.12"
  }
