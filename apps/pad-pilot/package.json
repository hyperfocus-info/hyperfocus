{
  "name": "@hyperfocus/pad-pilot-app",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "bun@1.4.0",
  "version": "0.0.1",
  "scripts": {
    "scripts/build": "bun run ./scripts/build.ts",
    "build:ui": "bun run ./scripts/build-ui.ts",
    "build:plugin": "bun run ./scripts/build-cmake-target.ts PadPilot_VST3",
    "build:standalone": "bun run ./scripts/build-cmake-target.ts PadPilot_Standalone",
    "build": "bun run scripts/build",
    "copy": "bun run ./scripts/copy-vst3.ts",
    "build:release": "bun run ./scripts/build.ts --config Release --no-copy --minify",
    "build:release:copy": "bun run ./scripts/build.ts --config Release --minify",
    "create-chain-preset": "bun run ./scripts/create-chain-preset.ts",
    "create-fx-preset": "bun run ./scripts/create-fx-preset.ts",
    "create-plugin-update": "bun run ./scripts/create-plugin-update.ts",
    "dev": "bun run scripts/dev.ts",
    "generate:proto": "bun run ./scripts/generate-proto.ts",
    "generate:fx-presets": "bun run ./scripts/generate-fx-curated-presets.ts",
    "generate:fl-studio-presets": "bun run ./scripts/generate-fl-studio-validation-presets.ts",
    "generate:factory-modules": "bun run ./scripts/generate-factory-modules.ts",
    "loc": "bun run ./scripts/lines-of-code.ts",
    "start": "bun run --cwd ../pad-pilot-marketplace start",
    "synaesthetic:analyze": "bun run ./scripts/synaesthetic-evaluator/evaluation-cli.ts analyze",
    "synaesthetic:serve": "bun run ./scripts/synaesthetic-evaluator/evaluation-cli.ts serve",
    "synaesthetic:start": "bun run ./scripts/synaesthetic-evaluator/evaluation-service.ts",
    "build:synaesthetic-dashboard": "bun run ./scripts/build-synaesthetic-dashboard.ts",
    "test": "bun run test:fast && bun run test:native && bun run test:acceptance",
    "test:fast": "bun run test:ui && bun run test:plugin-contracts && bun run test:marketplace && bun run test:scripts",
    "test:native": "bun run ./scripts/test-native.ts",
    "test:acceptance": "bun run --cwd ../pad-pilot-marketplace test:server && bun test --conditions browser --preload ./ui/src/test-setup.ts ./ui/src/app.acceptance.test.tsx",
    "test:plugin-contracts": "bun test ./plugin/runtime",
    "test:plugin-native": "bun run ./scripts/test-plugin-native.ts",
    "test:plugin-updater": "bun run ./scripts/test-plugin-updater.ts",
    "test:ui": "bun run ./scripts/test-ui.ts",
    "test:ui:coverage": "bun test --conditions browser --preload ./ui/src/test-setup.ts --coverage --coverage-reporter=text ./ui/src",
    "bootstrap:vst-validators": "bun run ./scripts/bootstrap-vst-validators.ts",
    "prepare:fl-studio-validation": "bun run ./scripts/validate-fl-studio.ts --prepare",
    "validate:fl-studio": "bun run ./scripts/validate-fl-studio.ts",
    "validate:vst3": "bun run ./scripts/validate-vst3.ts",
    "test:marketplace": "bun run --cwd ../pad-pilot-marketplace test",
    "test:scripts": "bun test ./scripts",
    "typecheck": "bunx tsc --noEmit -p ./tsconfig.json",
    "kill-all": "bun run ./scripts/kill-padpilot-processes.ts"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@happy-dom/global-registrator": "^20.11.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/bun": "1.4.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^25.9.5",
    "bun-plugin-solid": "^1.0.0",
    "bun-types": "1.4.0",
    "grpc-tools": "^1.13.1",
    "happy-dom": "^20.11.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@clerk/clerk-js": "^6.25.13",
    "@clerk/ui": "^1.27.2",
    "@dschz/solid-uplot": "0.5.2",
    "@hyperfocus/pad-pilot": "workspace:*",
    "@hyperfocus/ui": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/solid-hotkeys": "^0.3.3",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "@uploadthing/solid": "^7.3.3",
    "audio-decode": "^3.11.4",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "elysia": "^1.4.29",
    "lucide-solid": "^0.575.0",
    "mathjs": "^15.2.0",
    "solid-js": "1.9.15",
    "uploadthing": "^7.7.4",
    "uplot": "^1.6.32",
    "zod": "^3.25.76"
  },
  "exports": {
    "./module-ui-rule": "./scripts/module-ui/rule.ts"
  }
}
