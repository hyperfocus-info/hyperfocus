    "bench": "bun test ./src/wasm/collision-kernel.bench.test.ts",
    "check": "bun run typecheck && bun run typecheck:tests && bun run typecheck:tooling && bun run typecheck:examples && bun run typecheck:editor && bun run check:compatibility && bun run build && bun run check:bundle-size && bun run build:examples && bun run build:editor && bun run smoke:package && bun run test:all",
    "check:compatibility": "bun test ./scripts/compatibility-contract.test.ts ./scripts/production-readiness.test.ts",
    "check:bundle-size": "bun ./scripts/bundle-size-budget.ts",
    "release:package-consumer": "bun run smoke:package:consumer",
    "release:verify": "bun run check && bun run bench && bun run release:package-consumer && bun run release:wasm-asset && bun run release:wasm-hosting",
    "release:wasm-asset": "bun run smoke:vite-wasm-asset",
    "release:wasm-hosting": "bun run smoke:wasm-hosting",
