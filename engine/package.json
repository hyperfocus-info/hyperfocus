    "bench:render-draw-cache": "bun ./scripts/render-draw-cache-bench.ts",
    "bench:render-2d": "bun ./scripts/render-2d-bench.ts --assert-max-regression-pct 25 --assert-stage-cull-improvement-pct 25",
